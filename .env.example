DATABASE_URL=postgresql://user:password@host/database?sslmode=require
AUTH_SECRET=replace-with-a-long-random-string

# --- Nguồn gợi ý cho bài "Ôn tập Quang học giữa kì 1" và "Thấu kính · AI trợ giảng" ---
# Server only. Never prefix these with NEXT_PUBLIC_.
#
# OPTICS_AI_PROVIDER: gemini | openai | rules
#   Để trống thì tự suy ra: có GEMINI_API_KEY -> gemini, còn lại -> openai.
#   Đặt "rules" để chạy hoàn toàn miễn phí, không gọi mạng: học sinh vẫn có lộ
#   trình cá nhân hóa và gợi ý từ lời giải chuẩn, chỉ không có gợi ý do AI viết.
OPTICS_AI_PROVIDER=

# Gemini (có bậc miễn phí). Lấy key tại https://aistudio.google.com/api-keys
GEMINI_API_KEY=

# OpenAI (trả phí). Model phải hỗ trợ Responses API + Structured Outputs.
OPENAI_API_KEY=

# Tên model. Bỏ trống khi dùng Gemini sẽ mặc định gemini-3.5-flash-lite.
#
# CẢNH BÁO hạn mức Gemini bậc miễn phí (kiểm tra số của bạn tại
# https://aistudio.google.com/rate-limit vì Google không còn công bố công khai):
#   gemini-3.5-flash-lite  -> 15 RPM | 250K TPM | 500 lượt/ngày  <-- nên dùng
#   gemini-3.1-flash-lite  -> 15 RPM | 250K TPM | 500 lượt/ngày
#   các model Flash thường -> chỉ 20 lượt/ngày, hết sau khoảng 3 học sinh
# Mỗi học sinh dùng tối đa 6 lượt gọi (chỉ ở chặng luyện tập), nên một lớp 33 em
# cần khoảng 198 lượt. Quota ngày reset 0h giờ Pacific, tức khoảng 14h giờ VN.
OPTICS_AI_MODEL=

# Trần số lượt gọi mỗi ngày, tính theo mốc reset của Gemini. Khi cạn, bài tự
# chuyển sang gợi ý theo quy tắc thay vì để provider trả 429 hàng loạt.
# Bỏ trống thì mặc định 460, chừa biên an toàn dưới mức 500 của Flash Lite.
OPTICS_AI_DAILY_BUDGET=
